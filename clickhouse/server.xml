<!-- Sized for a small, shared host (imagent's ClickHouse typically gets 2-4 GB).
     Smaller caches and lighter merges keep the server's own footprint low, so queries have room. -->
<clickhouse>
    <mark_cache_size>268435456</mark_cache_size>                 <!-- 256 MB (default 5 GB) -->
    <index_mark_cache_size>67108864</index_mark_cache_size>       <!-- 64 MB -->
    <uncompressed_cache_size>0</uncompressed_cache_size>
    <max_server_memory_usage_to_ram_ratio>0.85</max_server_memory_usage_to_ram_ratio>
    <merge_tree>
        <!-- Rows carry large payloads (whole conversations); merge them in small blocks. -->
        <merge_max_block_size>1024</merge_max_block_size>
        <max_bytes_to_merge_at_max_space_in_pool>2147483648</max_bytes_to_merge_at_max_space_in_pool>
    </merge_tree>
    <!-- Diagnostic system logs imagent doesn't use; each costs memory and background merges. -->
    <trace_log remove="1"/>
    <text_log remove="1"/>
    <metric_log remove="1"/>
    <asynchronous_metric_log remove="1"/>
    <latency_log remove="1"/>
    <error_log remove="1"/>
    <query_metric_log remove="1"/>
    <processors_profile_log remove="1"/>
    <part_log remove="1"/>
</clickhouse>
