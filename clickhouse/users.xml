<!-- Per-query limits for a small host: fewer reader threads means fewer large payload blocks in
     memory at once, and a query that would still overrun spills its GROUP BY to disk. -->
<clickhouse>
    <profiles>
        <default>
            <max_threads>2</max_threads>
            <max_block_size>8192</max_block_size>
            <preferred_block_size_bytes>262144</preferred_block_size_bytes>
            <max_bytes_before_external_group_by>536870912</max_bytes_before_external_group_by>
            <max_bytes_before_external_sort>536870912</max_bytes_before_external_sort>
        </default>
    </profiles>
</clickhouse>
